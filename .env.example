# ==============================================================
# CONFIGURACIÓN DE PLATAFORMA Y MARCA
# ==============================================================
# Tudex Live Chat es la base de código abierto.
# Tudex Social es la implementación y marca comercial predeterminada.
APP_NAME="Tudex Social"
VITE_APP_NAME="Tudex Social"

# ==============================================================
# PUERTOS Y CONEXIÓN
# ==============================================================
PORT=3005
BACKEND_PORT=3005
FRONTEND_PORT=8080
MONGODB_URI=mongodb://mongo:27017/tudex_social

# ==============================================================
# AUTENTICACIÓN TUDEX PASSPORT (POCKET ID / OIDC)
# ==============================================================
OIDC_ENABLED=true
OIDC_ISSUER=https://passport.tudexnetworks.com
OIDC_CLIENT_ID=710e8b14-d605-4a21-83d4-86ed0e002811
OIDC_CLIENT_SECRET=ArhyOPh1ZCBlvZl6QJukl42emPA7sIK5
OIDC_AUTHORIZE_URL=https://passport.tudexnetworks.com/authorize
OIDC_TOKEN_URL=https://passport.tudexnetworks.com/api/oidc/token
OIDC_USERINFO_URL=https://passport.tudexnetworks.com/api/oidc/userinfo
OIDC_END_SESSION_URL=https://passport.tudexnetworks.com/api/oidc/end-session
OIDC_JWKS_URL=https://passport.tudexnetworks.com/.well-known/jwks.json

# ==============================================================
# CACHÉ Y LÍMITES
# ==============================================================
CHATS_CACHE_TTL_MS=5000
MESSAGES_CACHE_TTL_MS=5000
AVATAR_TTL_MS=600000
AVATAR_FETCH_LIMIT=40
AVATAR_FETCH_TIMEOUT_MS=7000
DEFAULT_ACCOUNT_ID=default
API_KEY=
